{
  "name": "cashonize-wallet",
  "version": "0.15.2",
  "description": "Cashonize: Your entry point to CashTokens and Bitcoin Cash DeFi",
  "productName": "Cashonize",
  "author": "Mathieu Geukens",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cashonize/cashonize-wallet.git"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.ts \"./src*/**/*.{ts,js,vue}\" \"./test/**/*.{ts,js,vue}\"",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:i18n": "node scripts/checkI18n.ts",
    "generate:chaingraph": "gql-tada generate output",
    "dev": "quasar dev",
    "build": "quasar build",
    "test:e2e": "playwright test --config test/e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config test/e2e/playwright.config.ts --ui",
    "test:e2e:regtest": "playwright test --config test/e2e/regtest/playwright.config.ts"
  },
  "dependencies": {
    "@bitauth/libauth": "3.1.0-next.8",
    "@cashconnect-js/core": "1.0.0-alpha.31",
    "@cashconnect-js/nostr": "1.0.0-alpha.31",
    "@cashonize/bch-wallet-lib": "0.3.2",
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@quasar/extras": "^2.1.0",
    "@reown/walletkit": "1.6.0",
    "@walletconnect/core": "2.25.0",
    "@wizardconnect/core": "0.2.5",
    "@wizardconnect/wallet": "0.2.3",
    "pinia": "^4.1.0",
    "qr-scanner": "1.4.2",
    "qrcode-generator": "2.0.4",
    "quasar": "^2.35.2",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^4.6.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bch-wc2/interfaces": "^0.0.16",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@quasar/app-vite": "^3.10.3",
    "@types/node": "^24.13.4",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@walletconnect/types": "^2.25.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "gql.tada": "^1.11.4",
    "jiti": "^2.7.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^6.0.3",
    "vitest": "5.0.5",
    "vue-tsc": "^3.3.13",
    "ws": "^8.21.0"
  },
  "engines": {
    "node": "^26 || ^24 || ^22.12.0",
    "pnpm": ">= 11"
  },
  "packageManager": "pnpm@11.10.0"
}
