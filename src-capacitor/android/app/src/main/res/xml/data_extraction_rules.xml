<?xml version="1.0" encoding="utf-8"?>
<!-- The WebView's storage holds the seed, so the seed phrase is the only way a wallet moves.
     allowBackup="false" stops the cloud backup; from Android 12 on some phones ignore it for a
     phone-to-phone transfer, which these rules exclude. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
