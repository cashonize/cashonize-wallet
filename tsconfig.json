{
  "extends": "./.quasar/tsconfig.json",
  "compilerOptions": {
    "types": ["vitest/globals"],
    // scripts/ runs straight through node, which strips types rather than resolving them, so an
    // import between two scripts has to name the .ts file it means
    "allowImportingTsExtensions": true,
    // Types for the Chaingraph queries, derived from the schema rather than hand-written.
    // Editor-only: the committed graphql-env.d.ts is what vue-tsc and the build read.
    "plugins": [
      {
        "name": "gql.tada/ts-plugin",
        "schema": "https://gql.chaingraph.pat.mn/v1/graphql",
        "trackFieldUsage": false,
        "tadaOutputLocation": "./src/generated/graphql-env.d.ts"
      }
    ]
  },
  "exclude": [
    "dist",
    "node_modules",
    "src-capacitor",
    "src-cordova",
    "src-electron",
    "quasar.config.*.temporary.compiled*",
    "test/e2e/test-dapp"
  ]
}
